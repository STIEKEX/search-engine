# Copy to .env and fill in real values. Never commit .env.
PORT=3000
# Local:  mongodb://127.0.0.1:27017/mini-search
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mini-search
MONGODB_URI=

# Crawler. The User-Agent MUST include a way to contact you (CLAUDE.md rule).
CRAWLER_USER_AGENT=MiniSearchBot/0.1 (+mailto:your-email@example.com)
# Optional overrides (CLI flags win over these):
# CRAWLER_MAX_PAGES=50
# CRAWLER_MAX_DEPTH=2
# CRAWLER_MAX_LINKS_PER_PAGE=100
# CRAWLER_SAME_HOST_ONLY=true
# CRAWLER_MIN_DELAY_MS=1000   (values below 1000 are raised to 1000)
# CRAWLER_DATA_DIR=./data
